{
  "name": "sync-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "format": "pnpm --dir .. format -- sync-server",
    "format:check": "pnpm --dir .. exec prettier --check sync-server/src sync-server/package.json sync-server/tsconfig.json sync-server/README.md",
    "lint": "pnpm --dir .. exec eslint sync-server/src --ext .ts",
    "lint:fix": "pnpm --dir .. exec eslint sync-server/src --ext .ts --fix"
  },
  "dependencies": {
    "@tldraw/store": "^4.4.0",
    "@tldraw/sync-core": "^4.4.0",
    "@tldraw/tlschema": "^4.4.0",
    "@tldraw/utils": "^4.4.0",
    "@tldraw/validate": "^4.4.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
