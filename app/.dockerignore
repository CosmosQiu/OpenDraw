# ==================== MovieClaw App .dockerignore ====================
# 排除不需要进入Docker构建上下文的文件
# =================================================================

# 依赖目录
node_modules
.pnpm-store

# 构建输出
dist
build
*.tsbuildinfo

# 版本控制
.git
.gitignore
.gitattributes

# IDE和编辑器
.vscode
.idea
*.swp
*.swo
*~

# 测试文件
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境配置（敏感信息）
.env
.env.local
.env.*.local

# 操作系统文件
.DS_Store
Thumbs.db

# 文档（构建时不需要）
*.md
!README.md

# Docker相关文件本身
Dockerfile
docker-compose.yml
.dockerignore
